# ============ Which AI rewrites the resume keywords?  gemini | anthropic | none ============
# gemini    = Google Gemini (current choice)
# anthropic = Claude (needs paid API credits, separate from a Claude Pro plan)
# none      = no AI, free rules-based tailoring (still never adds skills outside skills_bank.yaml)
AI_PROVIDER=gemini

# ---------------- Gemini (https://aistudio.google.com/apikey) ----------------
GEMINI_API_KEY=
# Run `python main.py models` to list what your key can use. Cheaper: gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.8-flash
# Optional thinking depth: low | medium | high. Leave empty for the model default.
GEMINI_THINKING=medium

# ---------------- Email applications (free: Gmail + an app password) ----------------
# Used by `python main.py email` for jobs whose only route is an address on the company's own site.
# Google Account > Security > turn on 2-Step Verification > App passwords > create one named "job-applier" (16 letters).
# Use the Gmail address your resume shows, so recruiters' replies land in your normal inbox. Never use your real password.
SMTP_USER=
SMTP_PASSWORD=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587

# ---------------- Anthropic (https://console.anthropic.com/) ----------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
ANTHROPIC_EFFORT=low
